# Copy to .env and fill in. Never commit the real .env.

# --- service ---
APP_NAME=GridWise Energy Optimizer
LOG_LEVEL=INFO
# Adds the exception message to 500 bodies. Local only — keep off in deployment.
DEBUG=false

# --- LLM (Section 02/08) ---
# OpenRouter key (https://openrouter.ai/keys) — starts with sk-or-v1-
LLM_API_KEY=
# Leave blank for OpenAI; set for any OpenAI-compatible endpoint (OpenRouter, Groq, ...).
LLM_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model slugs are namespaced: vendor/model.
LLM_MODEL=openai/gpt-4o-mini
# Comma-separated, tried in order when the model above is overloaded or slow.
LLM_FALLBACK_MODELS=google/gemini-2.5-flash-lite,google/gemini-3.5-flash,openai/gpt-4.1-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- optimizer ---
SOLVER_TIME_LIMIT_SECONDS=10
