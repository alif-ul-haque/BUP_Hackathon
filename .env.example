# Copy to .env and fill in. Never commit the real .env.

# --- service ---
APP_NAME=GridWise Energy Optimizer
LOG_LEVEL=INFO
# Adds the exception message to 500 bodies. Local only — keep off in deployment.
DEBUG=false

# --- LLM (Section 02/08) ---
LLM_API_KEY=
# Leave blank for OpenAI; set for any OpenAI-compatible endpoint (Groq, Together, ...).
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- optimizer ---
SOLVER_TIME_LIMIT_SECONDS=10
